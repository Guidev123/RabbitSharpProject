<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Every TFM the package ships is exercised here, so none of them reaches NuGet untested. -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<!--
			Microsoft.Extensions.Logging.Abstractions and Microsoft.Extensions.Configuration.Abstractions
			are not referenced here on purpose: they come from the library at the version that TFM
			requires, and pinning them would be a downgrade (NU1605).
		-->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	</ItemGroup>

	<!--
		For ConfigurationBuilder/AddInMemoryCollection, to build an IConfiguration in tests.
		Microsoft.Extensions.Configuration.Binder (referenced by the library) itself requires
		Microsoft.Extensions.Configuration at its own version, so this has to follow the same pinning
		per TFM as the library's own dependencies, rather than one fixed version (NU1605).
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.21" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\RabbitSharp\RabbitSharp.csproj" />
	</ItemGroup>

</Project>
