<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Version>3.0.0</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Package Metadata -->
		<PackageId>RabbitSharp</PackageId>
		<Title>RabbitSharp</Title>
		<Description>A high-performance, highly customizable RabbitMQ Pub/Sub library for .NET 8+ applications with built-in retry mechanisms and dead letter queue support.</Description>
		<Summary>RabbitMQ Pub/Sub library with retry mechanisms, dead letter queues, and convention-based configuration for .NET 8+</Summary>
		<PackageTags>rabbitmq;pubsub;messaging;dotnet;retry;deadletter;queue;resilience</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<!-- Author and Company Info -->
		<Authors>Guilherme</Authors>
		<Company>GR-Code</Company>
		<Copyright>© 2026 GR-Code. All rights reserved.</Copyright>

		<!-- Repository Info -->
		<RepositoryUrl>https://github.com/Guidev123/RabbitSharpProject</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/Guidev123/RabbitSharpProject</PackageProjectUrl>
		<PackageIcon>angry.rabbit.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Symbol Package Configuration -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

	</PropertyGroup>

	<!--
		Versions bumped above each TFM's own baseline to satisfy what Microsoft.Extensions.Resilience
		pulls in transitively (Microsoft.Extensions.Diagnostics.ExceptionSummarization /
		Telemetry.Abstractions) - NuGet treats anything lower as a downgrade error (NU1605).
	-->
	<!-- .NET 8.0 Dependencies -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>

	<!-- .NET 9.0 Dependencies -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
	</ItemGroup>

	<!-- .NET 10.0 Dependencies -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
	</ItemGroup>

	<!-- Common Dependencies for all frameworks -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Resilience" Version="10.11.0" />
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="angry.rabbit.png" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RabbitSharp.UnitTests" />
	</ItemGroup>

</Project>